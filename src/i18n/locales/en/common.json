    "vault": {
      "chapter": "Chapter VI · The Vault",
      "headline": "Loot worth grinding for. Both real and rare.",
      "lead": "Two parallel economies, one wallet. Spend your earned coins on <em>real-world</em> rewards you defined for yourself — and chase Vault drops: cosmetic crowns, character classes, badges so rare they leave a mark on your profile forever.",
      "item1Title": "Sovereign's Crown",
      "item1Desc": "Cosmetic head item. Earned by ranking A or higher for a full season.",
      "item2Title": "Astral Cloak",
      "item2Desc": "Mythic-tier vanity. Pulses with cosmic light during focus sessions.",
      "item3Title": "Blade of Discipline",
      "item3Desc": "Off-hand vanity. Glows brighter the longer your active streak grows.",
      "item4Title": "Tome of Hours",
      "item4Desc": "Real-world reward: 4 unscheduled hours, defended by Aetheria from your calendar."
    },
    "guild": {
      "chapter": "Chapter VII · The Guild",
      "headline": "142,000 heroes. One quiet, focused realm.",
      "lead": "Aetheria isn't a feed. There's no infinite scroll, no rage-bait, no follower count. Just a small, optional party system where the only thing you can publish is <em>your own progress</em>.",
      "kaedeQuote": "Three months in and I've finally written more than I've doom-scrolled. The quest system did the thing meditation apps couldn't.",
      "ariaQuote": "Other apps tracked what I did. Aetheria made me want to do it. The first habit tracker I haven't deleted in shame after six weeks.",
      "toraQuote": "I run a 12-person engineering team. We use the Guild feature like a war room. Quiet, focused, no Slack noise. Productivity tripled, vibes intact."
    },
