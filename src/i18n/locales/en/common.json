      "m2Sub": "0/1 done",
      "m3Label": "Log every meal of the day",
      "m3Sub": "1/3 done",
      "focusTag": "◆ 05 · FOCUS FORGE",
      "focusTitle": "A timer that doubles XP under pressure.",
      "focusDesc": "Lock in a deep-work session. Stay through, get a multiplier. Break early, take the penalty. The honor system, gamified.",
      "focusDeepWork": "DEEP WORK",
      "focusMode": "FOCUS MODE",
      "charTag": "◆ 06 · CHARACTER",
