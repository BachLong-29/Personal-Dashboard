    "darkness": {
      "chapter": "Chapter I · The Realm Before",
      "headline": "Most days end the same: tabs, regret, and a checklist that bullied you.",
      "lead": "To-do apps treat you like a database. Calendars treat you like a meeting. Habit trackers shame you in lowercase serif. None of them feel like <em>they are on your side</em> — and so the work piles up, the streaks die, and another week dissolves into noise.",
      "s1Title": "Endless Procrastination",
      "s1Body": "The plan exists. The energy doesn't. You open three apps, close them, scroll, and the morning is gone.",
      "s2Title": "Drifting Without Direction",
      "s2Body": "You know what you \"should\" do. You don't know what to do first. Everything is medium-urgent forever.",
      "s3Title": "Streaks That Die in Silence",
      "s3Body": "A 19-day streak vanishes. No fanfare, no recovery path. Just a quiet hole where the discipline used to live.",
      "s4Title": "Goals That Never Land",
      "s4Body": "\"Get fit.\" \"Learn the language.\" \"Finish the book.\" Same goals, three years running. No felt progress.",
      "s5Title": "Burnout Disguised as Hustle",
      "s5Body": "You worked 11 hours. You feel nothing. The graph in your head is flat. There is no level, only Tuesday.",
      "s6Title": "Chaos Disguised as Schedule",
      "s6Body": "15 reminders, 3 colors, 0 momentum. Tools that organize your overwhelm without ever reducing it.",
      "yesterdayQuests": "Yesterday's quests",
      "abandoned": "Abandoned",
      "r1Name": "Workout · 30 min",
      "r1Days": "skipped 4d",
      "r2Name": "Read 20 pages",
      "r2Days": "skipped 6d",
      "r3Name": "Deep work block · 2h",
      "r3Days": "skipped 2d"
    },
    "ascent": {
      "chapter": "Chapter II · The Ascent",
      "headline": "Watch a 90-day arc unfold inside one screen.",
      "lead": "Aetheria isn't about willpower — it's about <em>feedback</em>. Tiny daily quests build into visible momentum, and your character starts becoming someone you actually want to be. Here's what the same person looks like across one season.",
      "day": "DAY",
      "s1Rank": "◆ D-Rank · Drifter",
      "s1Title": "The Awakening",
      "s1Note": "\"Picked a class. Set 3 quests. Felt small, but I closed two of them.\"",
      "s2Rank": "◆ C-Rank · Apprentice",
      "s2Title": "First Streak",
      "s2Note": "\"Hit a 7-day streak. Got a first achievement. The dopamine is real.\"",
      "s3Rank": "◆ B-Rank · Adept",
      "s3Title": "Momentum",
      "s3Note": "\"My weeks have a rhythm now. The dashboard knows me. I show up before I think.\"",
      "s4Rank": "◆ A-Rank · Sovereign",
      "s4Title": "Becoming",
      "s4Note": "\"I'm not the same person. The character on screen finally caught up to the one in my head.\""
    },
    "system": {
      "chapter": "Chapter III · The System",
      "headline": "Three loops. One emerging hero.",
      "lead": "Underneath the cinematic theming is a serious engine: a daily quest loop, a long-arc progression layer, and an in-world reward economy that ties them together. Each one is fun on its own. Together they're how transformation actually compounds.",
      "questLabel": "Quest",
      "questTitle": "Define the Day.",
      "questDesc": "Bring in real-life tasks — workouts, deep work, study, errands. Aetheria ranks them by difficulty, weights the XP, and arranges them into a single, calm play queue.",
      "levelLabel": "Level",
      "levelTitle": "Track the Climb.",
      "levelDesc": "Every completion ripples into character stats, streak multipliers, and a long XP arc visible at a glance. You stop measuring time in days and start measuring it in <em>progress</em>.",
      "rewardLabel": "Reward",
      "rewardTitle": "Cash It In.",
      "rewardDesc": "Spend earned coins on <em>real-world</em> rewards you defined (a coffee, an hour off, a new book) and unlock cosmetic loot, character classes, and rare badges in the Vault.",
      "reward1Name": "Saturday Afternoon Off",
      "reward1Sub": "Self-Defined · Earned",
      "reward2Name": "Crown of Embers",
      "reward2Sub": "Cosmetic · 0.5% drop"
    },
    "arsenal": {
      "chapter": "Chapter IV · The Arsenal",
      "headline": "Every tool you've used. Re-imagined as one living system.",
      "lead": "Calendar, to-do, habit tracker, journal, mood log — they all collapse into one interface that's coherent, deep, and built for someone who actually wants to <em>change</em>.",
      "qsTag": "◆ 01 · QUEST SYSTEM",
      "qsTitle": "Tasks reframed as battles worth winning.",
      "qsDesc": "Difficulty ranks (S→D), party quests with friends, recurring chains, and built-in penalty contracts for the ones you keep dodging.",
      "qsQ1": "Hydrate · 2L",
      "qsQ2": "Morning Pages",
      "qsQ3": "Defeat the Inbox Specter",
      "qsQ4": "Ship the Pull Request",
      "qsQ5": "First Marathon · 42km",
      "schedTag": "◆ 02 · SMART SCHEDULE",
      "schedTitle": "An itinerary that respects your energy.",
      "schedDesc": "Aetheria reads your stat curves, past completion times, and energy log — and proposes a single, calm sequence for the day you can actually execute.",
      "schedR1": "Morning Routine",
      "schedR2": "Deep Work · Chapter Draft",
