    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "mongoose": "^9.6.2",
    "next": "16.2.4",
    "next-intl": "^4.11.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
